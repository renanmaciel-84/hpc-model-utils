      "regexPattern": "",
      "format": "",
      "order": 9,
      "options": [
        "@@env:queueNewave@@",
        "@@env:queueDecomp@@",
        "@@env:queueCobre@@"
      ]
    },
    {
      "description": "Nome do cobre",
      "name": "modelName",
      "type": "String",
      "defaultValue": "cobre",
      "visible": false,
      "regexPattern": "",
      "format": "",
      "order": 10,
      "options": []
    },
    {
      "description": "Versao do cobre a ser utilizada",
      "name": "modelVersion",
      "type": "List",
      "defaultValue": "v0.18.0",
      "visible": true,
      "regexPattern": "",
      "format": "",
      "order": 11,
      "options": [
        "v0.18.0",
        "v0.18.1"
      ]
    },
    {
      "description": "Caminho utilizado para a execucao",
      "name": "path",
      "type": "String",
      "defaultValue": "",
      "visible": false,
      "regexPattern": "(?<=Created temporary dir\\s)(/[^ ]+)",
      "format": "{0}",
      "order": 12,
      "options": []
    },
    {
      "description": "ID do job atribuido pelo SLURM",
      "name": "jobId",
      "type": "String",
      "defaultValue": "",
      "visible": false,
      "regexPattern": "Submitted batch job (\\d+)",
      "format": "{1}",
      "order": 13,
      "options": []
    },
    {
      "description": "Diretorio versionado do hpc-model-utils, capturado do ensure-utils",
      "name": "utilsToolDir",
      "type": "String",
      "defaultValue": "",
      "visible": false,
      "regexPattern": "HPCMU_TOOL hpc-model-utils (/\\S+)",
      "format": "{1}",
      "order": 14,
      "options": []
    },
    {
      "description": "Diretorio versionado do novomodelo-bridge, capturado do ensure-utils",
